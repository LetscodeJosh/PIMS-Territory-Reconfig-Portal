[Unit]
Description=PIMS Territory Reconfiguration Portal (Pure GCP Bare-Metal Streamlit Service)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{APP_DIR}}
ExecStart={{VENV_DIR}}/bin/streamlit run app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true
Restart=always
RestartSec=5s

# Process Environment
Environment=PYTHONUNBUFFERED=1
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8

# Security & Sandboxing Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths={{APP_DIR}}

# Resource Limits (Ensures stability on e2-micro, e2-small, e2-medium)
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target


# =============================================================================
# PIMS Territory Reconfiguration Portal - Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env: `cp .env.example .env` (or set in Streamlit Secrets / OS environment)
# 2. Configure your specific ERPNext domain and credentials below.
# 3. NEVER commit your actual .env or secrets file to version control!
# =============================================================================

# ERPNext Endpoint (e.g. https://erp.yourcompany.com or your live domain)
ERPNEXT_URL=https://erp.yourcompany.com

# PIMS Backend Service Account (Optional: Used for server-side live territory sync)
PIMS_SERVICE_USER=
PIMS_SERVICE_PASSWORD=

# Session HMAC Security Key (Optional: Provide 64-char random hex key. Ephemeral key generated if omitted)
SESSION_SECRET=

# Frappe Direct API Credentials (Optional: If using Token key:secret auth)
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# SSL Verification (Set to 1 ONLY for self-signed certificates in isolated test environments)
ERPNEXT_INSECURE_SSL=0
